# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Vite may be opened through either hostname during local development.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production HTTPS settings are enabled automatically when DJANGO_DEBUG=false.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

# JWT and login protection
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=1
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCKOUT_MINUTES=15

# PostgreSQL
POSTGRES_DB=aaiapp
POSTGRES_USER=aaiapp
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
